# ─────────────────────────────────────────────────────────────────────────────
# Dr.Rock — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED for rock analysis — server-side only (never exposed to the browser).
# Create a key at https://platform.claude.com/ → API keys.
# Without it the app still works (library, collection), but analysis returns
# "AI not configured" and never invents results.
ANTHROPIC_API_KEY=

# Optional: multimodal Claude model used for analysis (default: claude-opus-5-5).
# DR_ROCK_MODEL=claude-opus-5-5

# Optional: reasoning effort: low | medium | high | xhigh | max (default: high).
# "medium" answers faster; "high" is more thorough.
# DR_ROCK_EFFORT=high

# Optional: per-attempt AI timeout in seconds (default: 140) and retries (default: 1).
# Keep timeout x (retries + 1) under your host's function limit. Netlify (60 s): 50 and 0.
# DR_ROCK_TIMEOUT_SECONDS=140
# DR_ROCK_MAX_RETRIES=1

# Optional: per-client analysis rate limit (default: 12 requests / 600 s).
# RATE_LIMIT_MAX=12
# RATE_LIMIT_WINDOW_SECONDS=600

# Public URL of the deployment (used for metadata / social cards).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public contact address shown in the landing page footer.
# NEXT_PUBLIC_CONTACT_EMAIL=

# Future (accounts & cloud sync, not used in v1): see prisma/schema.prisma
# DATABASE_URL=postgresql://user:password@localhost:5432/drrock
